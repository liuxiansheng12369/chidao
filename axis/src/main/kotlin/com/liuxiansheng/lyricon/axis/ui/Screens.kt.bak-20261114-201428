enum class Route { Home, Search, Paste, Review, Tap, Proofread, Save, Transfer }

/** 敲轴两种档位：逐字敲（一个字一下）/ 快敲（一句一下，字由系统均分）。 */
enum class TapMode { CHAR, LINE }

class DraftLine(text: String) {
    var text: String by mutableStateOf(text)
    var keep by mutableStateOf(true)
}

/** 播放器实时状态：位置毫秒 + 是否真在播。没有播放会话时由调用方返回 null。 */
data class LiveState(val positionMs: Long, val playing: Boolean)

data class Candidate(
    val title: String,
    val artist: String,
    val album: String,
    val durationMs: Long,
    val lines: List<String>,
    val hasTiming: Boolean,
    val web: WebSong? = null,
) {
    fun durationLabel(): String = mmss(durationMs)
    /** 差 2 秒以内才算同一首（整秒比），防止串轴。 */
    fun matches(targetMs: Long): Boolean = targetMs > 0L && abs(durationMs - targetMs) <= 2000L
}

class AxisState(
    initialTitle: String = "",
    initialArtist: String = "",
    initialDurationMs: Long = 0L,
    private val startAtSearch: Boolean = false,
) {

    var route by mutableStateOf(if (startAtSearch) Route.Search else Route.Home)
    /** 核对页返回到哪：从搜词来就回搜词，从首页粘贴 / 本地文件来就回首页。 */
    private var reviewFrom by mutableStateOf(Route.Search)
    var title by mutableStateOf(initialTitle)
    var artist by mutableStateOf(initialArtist)
    var keyword by mutableStateOf(initialTitle)
    var durationMs by mutableStateOf(initialDurationMs)
    /** 打点时不再统一扣提前量（0）；整体误差交给「调值」处理。 */
    var leadMs by mutableStateOf(0)
    /** 整轴调值：只在播放时平移，记录不动。负=提前，正=延后。 */
    var offsetMs by mutableStateOf(0)
    var sourceLabel by mutableStateOf(if (initialDurationMs > 0L) "当前播放" else "还没选歌")

    /** 播放器给的真实时长。搜到同一首时用它，岛上才命中。 */
    private val playerDurationMs = initialDurationMs

    /** 播放器给的歌名/歌手。搜词只取歌词文本，身份以它为准（见 loadCandidate）。 */
    private val playerTitle = initialTitle
    private val playerArtist = initialArtist

    /**
     * 用户自己手填过歌名或歌手。
     * 只有「粘贴文本」页那种明确填身份的输入框会置这个标记，搜词页那两格是用来搜词的、不置。
     * 置了就以用户写的为准，不再被播放器覆盖 —— "我输的你也保存"。
     */
    var identityEdited by mutableStateOf(false)

    /** 正在编辑的历史条目 key；为空 = 新建，保存时才对齐到播放器。见 openSaved / saveTo。 */
    var editingKey by mutableStateOf("")

    /**
     * 编辑已有轴时是否保留原有行（不按"敲到哪句"截断）。
     * 打开旧轴默认 true：带上原来每一行的时间，改几句保存也不会把后面几十句截掉；
     * 点了「清空重敲」才变 false，回到新建时的截断规则。
     */
    var keepAllRows by mutableStateOf(false)

    /** 核对页自动舍弃超长行后的提示文案，空串表示没有。 */
    var dropNotice by mutableStateOf("")

    var searching by mutableStateOf(false)
    var searchError by mutableStateOf("")
    var pickingId by mutableStateOf("")
    /** 手粘歌词（断网兜底用）。 */
    var pasted by mutableStateOf("")
    var upgrading by mutableStateOf(false)
    var upgradeMsg by mutableStateOf("")

    var playing by mutableStateOf(false)
    var baseMs by mutableStateOf(0L)
    var startedAt by mutableStateOf(0L)
    var tick by mutableStateOf(0L)

    /** 由词岛侧注入：返回播放器实时状态（位置 + 是否在播），拿不到返回 null。 */
    private var liveStateSource: (() -> LiveState?)? = null
    /** 由词岛侧注入：转发播放/暂停/跳转给真正的播放器。 */
    private var mediaControl: ((String, Long) -> Unit)? = null
    /** 跟随系统播放器：位置与播放状态都以播放器为准。 */
    var following by mutableStateOf(false)
    /** 用户要跟随、但这会儿还读不到播放器（会话没绑好/刚切歌）——留着这个意向一直重试。 */
    var followIntent by mutableStateOf(false)

    fun bindLiveState(
        source: (() -> LiveState?)?,
        control: ((String, Long) -> Unit)? = null,
    ) {
        liveStateSource = source
        mediaControl = control
    }

    fun startFollowing() {
        val s = liveStateSource?.invoke()
        if (s == null) {
            // 读不到不等于放弃：进页面那一刻媒体会话可能还没被系统绑上，
            // 记下意向后由页面每拍重试一次，否则一次失败就一直停在"独立计时"
            following = false
            followIntent = true
            return
        }
        baseMs = s.positionMs
        startedAt = SystemClock.elapsedRealtime()
        playing = s.playing
        following = true
        followIntent = false
    }

    /**
     * 每拍校正一次：位置和播放状态都以播放器为准。
     * 读不到（没会话/切歌中）只把时间停住，**不退出跟随**——
     * 一旦退出就再也接不回来，这正是"拖回去了它还在走"的原因。
     */
    fun syncFromPlayer() {
        if (!following) return
        val s = liveStateSource?.invoke()
        if (s == null) {
            playing = false
            return
        }
        baseMs = s.positionMs
        startedAt = SystemClock.elapsedRealtime()
        playing = s.playing
    }

    fun control(cmd: String, arg: Long = 0L) {
        mediaControl?.invoke(cmd, arg)
    }

    /** 播放 / 暂停：跟着播放器时遥控播放器，否则动打轴器自己的时钟。 */
    fun playPause() {
        if (following) control("toggle") else togglePlay()
    }

    /** 前后跳：本地立刻对齐，再让播放器跳；下一拍以播放器为准。 */
    fun jump(deltaMs: Long) {
        val target = (positionMs() + deltaMs).coerceIn(0L, durationMs)
        baseMs = target
        startedAt = SystemClock.elapsedRealtime()
        if (following) control("seek_by", deltaMs)
    }

    /** 直接跳到某个位置：拖进度条松手走这里。 */
    fun jumpTo(ms: Long) {
        val target = ms.coerceIn(0L, durationMs.coerceAtLeast(0L))
        baseMs = target
        startedAt = SystemClock.elapsedRealtime()
        if (following) control("seek_to", target)
    }

    val draft = mutableStateListOf<DraftLine>()
    val begins = mutableStateListOf<Long?>()                       // 行首时间
    val wordsDone = mutableStateListOf<MutableList<Long?>>()       // 行 × 字 的开始时间
    var cursorLine by mutableStateOf(0)
    var cursorChar by mutableStateOf(0)
    var tapMode by mutableStateOf(TapMode.CHAR)                    // 逐字敲 / 快敲

    val results = mutableStateListOf<Candidate>()
    var savedAxis by mutableStateOf<ManualAxis?>(null)
    var recentStamp by mutableStateOf(0)

    init {
        recentStamp = 0
    }

    /**
     * 当前位置。
     * 跟随播放器时每次都直接问播放器（现在指向系统媒体会话，本地调用，很便宜），
     * 不再用"本地时钟推算 + 每 500ms 硬校准"：那种做法每校准一次就会跳一下，
     * 打点正好落在校准前后，就会差几十到上百毫秒，逐句看起来就是忽早忽晚。
     */
    fun positionMs(): Long {
        if (following) {
            val s = liveStateSource?.invoke()
            if (s != null) {
                baseMs = s.positionMs
                startedAt = SystemClock.elapsedRealtime()
                playing = s.playing
                return s.positionMs.coerceIn(0L, durationMs.coerceAtLeast(0L))
            }
        }
        val raw = if (playing) baseMs + (SystemClock.elapsedRealtime() - startedAt) else baseMs
        return raw.coerceIn(0L, durationMs.coerceAtLeast(0L))
    }

    fun togglePlay() {
        following = false
        followIntent = false
        if (playing) {
            baseMs = positionMs()
            playing = false
        } else {
            startedAt = SystemClock.elapsedRealtime()
            playing = true
        }
    }

    fun skip(deltaMs: Long) {
        baseMs = (positionMs() + deltaMs).coerceIn(0L, durationMs)
        startedAt = SystemClock.elapsedRealtime()
    }

    // ——— 跳过未勾选行：只挪光标和列表，不动数据 ———

    /** 从 from 开始往后找第一个勾选了的行；没有就返回 draft.size。 */
    fun nextTappable(from: Int): Int {
        var i = from.coerceAtLeast(0)
        while (i < draft.size && !draft[i].keep) i++
        return i
    }

    /** 从 from 开始往前找第一个勾选了的行；没有就返回 -1。 */
    fun prevTappable(from: Int): Int {
        var i = from.coerceAtMost(draft.size - 1)
        while (i >= 0 && !draft[i].keep) i--
        return i
    }

    fun tap() {
        cursorLine = nextTappable(cursorLine)
        if (cursorLine >= draft.size) return
        val line = wordsDone.getOrNull(cursorLine) ?: return
        if (line.isEmpty()) { advanceLine(); return }
        if (tapMode == TapMode.LINE) {
            // 快敲：只写行首
            begins[cursorLine] = positionMs()
            line[0] = begins[cursorLine]
            advanceLine()
            return
        }
        // 逐字敲：写当前字。按下的那一刻就是听到的那一刻，不再统一减提前量，
        // 整体的偏早偏晚一律用「调值」统一平移，不在打点时偷偷扣掉
        val at = positionMs()
        line[cursorChar] = at
        if (cursorChar == 0) begins[cursorLine] = at
        cursorChar += 1
        if (cursorChar >= line.size) advanceLine()
    }

    private fun advanceLine() {
        cursorLine = nextTappable(cursorLine + 1)
        cursorChar = 0
    }

    fun undo() {
        if (cursorChar > 0) {
            cursorChar -= 1
            wordsDone[cursorLine][cursorChar] = null
            if (cursorChar == 0) begins[cursorLine] = null
            return
        }
        if (cursorLine > 0) {
            val prev = prevTappable(cursorLine - 1)
            if (prev < 0) return
            cursorLine = prev
            val row = wordsDone[cursorLine]
            cursorChar = (row.size - 1).coerceAtLeast(0)
            if (row.isNotEmpty()) row[cursorChar] = null
            begins[cursorLine] = null
        }
    }

    /** 真去网上搜：网易云为主、QQ 兜底，结果按时长差排序。 */
    suspend fun search() {
        if (searching) return
        searching = true
        searchError = ""
        val kw = title.ifBlank { keyword }
        val tryRun = runCatching {
            withContext(Dispatchers.IO) { LyricSearch.search(kw, artist) }
        }
        val found = tryRun.getOrElse { emptyList() }
        withContext(Dispatchers.Main) {
            results.clear()
            results.addAll(
                found.map {
                    Candidate(
                        title = it.title,
                        artist = it.artist,
                        album = it.album.ifBlank { it.source.uppercase() },
                        durationMs = it.durationMs,
                        lines = emptyList(),
                        hasTiming = false,
                        web = it,
                    )
                }.sortedBy { c ->
                    if (durationMs > 0L) abs(c.durationMs - durationMs) else c.durationMs
                }
            )
            searchError = when {
                tryRun.isFailure -> "网络不通或接口暂时不可用，稍后再试"
                results.isEmpty() -> "没搜到，把歌名改短一点、去掉括号和版本名再试"
                else -> ""
            }
            searching = false
        }
    }

    /** 选中一个候选：后台把歌词取回来，取到才进核对页。 */
    suspend fun pickCandidate(candidate: Candidate) {
        val web = candidate.web
        if (web == null) {
            loadCandidate(candidate)
            return
        }
        if (pickingId.isNotBlank()) return
        pickingId = web.id
        searchError = ""
        val doc = runCatching {
            withContext(Dispatchers.IO) { LyricSearch.fetchDoc(web) }
        }.getOrNull()
        pickingId = ""
        if (doc == null || doc.lines.isEmpty()) {
            searchError = "这首拿不到歌词，换一个候选试试"
            return
        }
        loadCandidate(candidate.copy(lines = doc.lines, hasTiming = true))
    }

    /**
     * 可选升级：去 LRCLIB 查在线逐字轴。命中就整份换成逐字的，用户几乎不用敲。
     * 这是可选路径，不放在搜索主流程里，避免每次搜词白等。
     */
    suspend fun upgradeToWordSync() {
        if (upgrading) return
        if (title.isBlank()) {
            upgradeMsg = "先选一首歌"
            return
        }
        upgrading = true
        upgradeMsg = ""
        val doc = runCatching {
            withContext(Dispatchers.IO) { LyricSearch.fetchWordSync(title, artist, durationMs) }
        }.getOrNull()
        upgrading = false
        if (doc == null || doc.wordTimes == null || doc.lines.isEmpty()) {
            upgradeMsg = "这首没有在线逐字轴，接着手敲就行"
            return
        }
        applyWordDoc(doc)
    }

    /** 把带逐字时间的文档铺成待敲状态：行首取第一个字的时间，字时间逐格填好。 */
    private fun applyWordDoc(doc: LyricDoc) {
        draft.clear()
        draft.addAll(doc.lines.map { DraftLine(it) })
        begins.clear()
        wordsDone.clear()
        doc.lines.forEachIndexed { i, text ->
            val times = doc.wordTimes?.getOrNull(i)
            val tokens = AxisTokenizer.split(text)
            begins.add(times?.firstOrNull { it != null })
            wordsDone.add(MutableList(tokens.size) { ti -> times?.getOrNull(ti) })
        }
        cursorLine = nextTappable(0)
        cursorChar = 0
        sourceLabel = "在线逐字轴 · ${doc.lines.size} 句"
        upgradeMsg = "已导入在线逐字轴，${doc.lines.size} 句"
        route = Route.Tap
    }

    /** 断网 / 没搜到时的兜底：把手粘的歌词切成行直接用。 */
    fun usePasted(): Boolean {
        val lines = LyricSearch.clean(pasted)
        if (lines.isEmpty()) return false
        draft.clear()
        draft.addAll(lines.map { DraftLine(it) })
        begins.clear()
        draft.indices.forEach { begins.add(null) }
        wordsDone.clear()
        draft.indices.forEach { i ->
            wordsDone.add(MutableList(AxisTokenizer.split(draft[i].text).size) { null })
        }
        cursorLine = nextTappable(0)
        cursorChar = 0
        baseMs = 0L
        playing = false
        following = false
        startFollowing()
        editingKey = ""
        keepAllRows = false
        identityEdited = false
        dropLinesOutOfRange()
        sourceLabel = "手动粘贴 · ${lines.size} 句"
        route = Route.Tap
        return true
    }

    /**
     * 本地 .lrc / .txt 导入后落进编辑状态。
     * 带时间的行直接把时间填进 begins，敲轴页能看到哪些句已经就位；
     * 统一进核对页，让用户先决定哪几行要敲。
     */
    fun loadImported(imported: ImportedLyric, label: String): Boolean {
        if (imported.lines.isEmpty()) return false
        reviewFrom = Route.Home
        if (imported.title.isNotBlank()) title = imported.title
        if (imported.artist.isNotBlank()) artist = imported.artist
        if (imported.durationMs > 0L) durationMs = imported.durationMs
        // 本地文件 / 粘贴文本同样对齐到正在播的那首（歌名对得上才算同一首）
        alignToPlayer()
        keyword = title
        draft.clear()
        draft.addAll(imported.lines.map { DraftLine(it) })
        begins.clear()
        draft.indices.forEach { i -> begins.add(imported.begins.getOrNull(i)) }
        wordsDone.clear()
        draft.indices.forEach { i ->
            val n = AxisTokenizer.split(draft[i].text).size
            val fromFile = imported.wordsByLine.getOrNull(i)
            if (fromFile != null && fromFile.isNotEmpty()) {
                // 文件里的逐字粒度和本地分词不一定一致，按位置对齐，缺的留 null 交给均分
                wordsDone.add(MutableList(n) { k -> fromFile.getOrNull(k) })
            } else {
                wordsDone.add(MutableList(n) { null })
            }
        }
        cursorLine = nextTappable(0)
        cursorChar = 0
        baseMs = 0L
        playing = false
        following = false
        startFollowing()
        // 新建的一条轴，清掉"编辑中"标记
        editingKey = ""
        keepAllRows = false
        // 导入的 lrc 自带时间：比歌还长的句子永远播不到，先自动取消勾选
        dropLinesOutOfRange()
        sourceLabel = label
        route = Route.Review
        return true
    }

    /** 读本地文件的文本（.lrc / .txt 都按纯文本读）。 */
    fun importLocalFile(context: Context, uri: Uri): Boolean {
        val text = runCatching {
            context.contentResolver.openInputStream(uri)?.use { it.bufferedReader().readText() }
        }.getOrNull().orEmpty()
        if (text.isBlank()) return false
        val name = runCatching {
            context.contentResolver.query(uri, null, null, null, null)?.use { c ->
                val idx = c.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME)
                if (idx >= 0 && c.moveToFirst()) c.getString(idx) else null
            }
        }.getOrNull()
        val imported = LocalLyricImport.parse(
            raw = text,
            fallbackTitle = title,
            fallbackArtist = artist,
            fallbackDurationMs = durationMs,
        )
        return loadImported(
            imported,
            "本地文件${if (name != null) " · $name" else ""} · ${imported.lines.size} 句" +
                if (imported.hasAnyTiming) "（自带时间）" else ""
        )
    }

    /** 打开已存的轴继续改：**带出原来的时间**，不再清空重敲。 */
    fun openSaved(context: Context, entry: AxisIndexEntry): Boolean {
        val store = AxisStore(File(context.filesDir, "lyrics/manual"))
        val axis = runCatching { store.load(entry.songKey) }.getOrNull() ?: return false
        title = axis.title
        artist = axis.artist
        durationMs = axis.durationMs
        // 记住原条目：保存时写回这一份，不新建一条，免得"点了保存像没反应"
        editingKey = entry.songKey
        identityEdited = false
        dropNotice = ""
        offsetMs = axis.offsetMs
        sourceLabel = "已存的轴 · ${axis.lines.size} 句"
        draft.clear()
        draft.addAll(axis.lines.map { DraftLine(it.text) })
        begins.clear()
        wordsDone.clear()
        axis.lines.forEach { l ->
            val tokens = AxisTokenizer.split(l.text).size
            // 没有时间的行保持 null（由保存时的 fillMissing 补），有时间的原样带出来
            begins.add(l.beginMs.takeIf { it > 0L } ?: null)
            val wordTimes = l.words.map { it.beginMs }
            wordsDone.add(MutableList(tokens) { i -> wordTimes.getOrNull(i) })
        }
        // 编辑已有轴：行数按原来的句子走，不因为"只改了一两句"把后面整段截掉
        keepAllRows = true
        cursorLine = nextTappable(0)
        cursorChar = 0
        baseMs = 0L
        playing = false
        following = false
        startFollowing()
        route = Route.Tap
        return true
    }

    /** 把带出来的旧时间全部清空，从头再敲一遍（行数仍保留）。 */
    fun clearTimesForRewrite() {
        begins.indices.forEach { begins[it] = null }
        wordsDone.clear()
        draft.forEach { wordsDone.add(MutableList(AxisTokenizer.split(it.text).size) { null }) }
        keepAllRows = false
        cursorLine = nextTappable(0)
        cursorChar = 0
        baseMs = 0L
    }

    /**
     * 整首一起往前/往后挪。
     *
     * 敲完发现"全都早了半秒"或者"全都晚了"，不用逐句重敲：把已有的行时间和逐字时间
     * 统一加一个偏移就行，[deltaMs] 为负是往前、为正往后。没有时间的行保持 null。
     */
    fun shiftAll(deltaMs: Long) {
        begins.indices.forEach { i ->
            val v = begins[i] ?: return@forEach
            begins[i] = (v + deltaMs).coerceAtLeast(0L)
        }
        wordsDone.forEachIndexed { li, list ->
            for (k in list.indices) {
                val v = list[k] ?: continue
                list[k] = (v + deltaMs).coerceAtLeast(0L)
            }
        }
    }

    fun loadCandidate(candidate: Candidate) {
        reviewFrom = Route.Search
        title = candidate.title
        artist = candidate.artist
        durationMs = candidate.durationMs
        // 歌词来自哪条候选不重要，身份整段换成正在播的那首：歌名、歌手、秒数全以播放器为准
        forceAlignToPlayer()
        sourceLabel = "${candidate.album} · ${candidate.lines.size} 句"
        draft.clear()
        draft.addAll(candidate.lines.map { DraftLine(it) })
        begins.clear()
        draft.indices.forEach { begins.add(null) }
        wordsDone.clear()
        draft.indices.forEach { i ->
            val n = AxisTokenizer.split(draft[i].text).size
            wordsDone.add(MutableList(n) { null })
        }
        cursorLine = nextTappable(0)
        cursorChar = 0
        baseMs = 0L
        playing = false
        following = false
        // 这首歌正在播就自动跟上，用户不用自己按播放
        startFollowing()
        // 新建的一条轴
        editingKey = ""
        keepAllRows = false
        identityEdited = false
        dropLinesOutOfRange()
        // 取完词先进核对页，核对完用户自己点「去敲轴」
        route = Route.Review
    }

    fun back() {
        route = when (route) {
            Route.Home -> Route.Home
            Route.Search -> Route.Home
            Route.Paste -> Route.Home
            Route.Review -> reviewFrom
            Route.Tap -> Route.Review
            Route.Proofread -> Route.Tap
            Route.Save -> Route.Home
            Route.Transfer -> Route.Home
        }
    }

    fun resetTiming() {
        begins.clear()
        draft.indices.forEach { begins.add(null) }
        wordsDone.forEach { it.indices.forEach { k -> it[k] = null } }
        cursorLine = nextTappable(0)
        cursorChar = 0
    }

    /** 搜词结果里哪一条就是正在播的这首 —— 界面上标出来，用户直接点它。 */
    fun isNowPlaying(candidate: Candidate): Boolean =
        playerTitle.isNotBlank() && SongKey.sameSong(candidate.title, playerTitle)

    /**
     * 时长是客观事实，播放器测出来的，任何入口都对齐，**不受手改歌名影响**。
     *
     * 这一句必须放在两个 align 函数的 return 之前：用户在核对页改了歌名，
     * identityEdited 就会 true，如果把时长塞在 applyPlayerIdentity 里，
     * 整段被跳过，时长还停在上一条候选的 223 秒 → 播放器是 202 秒 → 反而命中不了。
     * 越纠越错就是这么来的。
     */
    private fun applyPlayerDuration() {
        if (playerDurationMs > 0L) durationMs = playerDurationMs
    }

    /**
     * 把身份对齐到"正在播的那首"（只在确实同一首时动）。
     *
     * 岛上的查询键是「歌名|歌手|时长秒」，这三个值全由播放器现场给出。
     * 用于「重打旧轴」「导入本地文件」这类入口：歌名对得上就换成播放器的写法，
     * 对不上就保持原样，免得把 A 歌的轴挂到 B 歌头上。
     *
     * 唯一例外：用户在「粘贴文本」页或核对页手填了歌名或歌手（identityEdited），那以他写的为准。
     * 但时长照旧以播放器为准。
     */
    internal fun alignToPlayer(): Boolean {
        applyPlayerDuration()
        if (playerTitle.isBlank()) return false
        if (identityEdited) return false
        if (!SongKey.sameSong(title, playerTitle)) return false
        title = playerTitle
        artist = playerArtist
        return true
    }

    /**
     * 无条件对齐到正在播的那首。
     *
     * 用在「点了搜词结果」之后：歌词是别的版本/别人翻唱的候选，歌名和歌手都可能跟播的不一样，
     * 但用户要的就是拿这份歌词给正在听的这首歌打轴，所以歌名歌手整段换成播放器的。
     * 一句话：歌词可以来自任何人，身份只认正在播的那首。时长同样照旧对齐。
     */
    internal fun forceAlignToPlayer(): Boolean {
        applyPlayerDuration()
        if (playerTitle.isBlank()) return false
        if (identityEdited) return false
        title = playerTitle
        artist = playerArtist
        return true
    }

    // ——— 核对页编辑：改字 / 删行 / 改名 / 丢超长行 ———

    /**
     * 改一行文字。
     * 字数变了，这一行的字级时间必须重置，否则原有时间点和新的字对不上，会串到相邻行。
     * 行首时间（begins）保留：整句在哪儿开始没被改文字影响。
     */
    fun updateLineText(index: Int, text: String) {
        if (index !in draft.indices) return
        draft[index].text = text
        if (index in wordsDone.indices) {
            wordsDone[index] = MutableList(AxisTokenizer.split(text).size) { null }
        }
    }

    /**
     * 删掉一行。
     * draft / begins / wordsDone 三个列表**必须同时删**——buildAxis 按同一个索引取三个列表的值，
     * 只删一个会让后面全部错位一行：第 5 句的文本配上第 6 句的时间。
     */
    fun removeLine(index: Int) {        if (index !in draft.indices) return
        draft.removeAt(index)
        if (index in begins.indices) begins.removeAt(index)
        if (index in wordsDone.indices) wordsDone.removeAt(index)
        cursorLine = nextTappable(0)
        cursorChar = 0
    }

    /**
     * 把某一行和相邻行（[delta] 为 -1 上移 / +1 下移）换位置。
     *
     * 三个列表一起换：文字、行首时间、逐字时间跟着这一行走，
     * 所以只是"这句唱早了/晚了"的顺序问题，换完时间还对得上，不会串到别句。
     */
    /**
     * 校对页：整句平移。
     * 行首时间和句内每个字一起挪，句内相对位置不变——
     * 用来修「这一句整体早了/晚了」，不会把句内的字挪乱。
     */
    fun nudgeLine(index: Int, deltaMs: Long) {
        val cur = begins.getOrNull(index) ?: return
        begins[index] = (cur + deltaMs).coerceAtLeast(0L)
        wordsDone.getOrNull(index)?.let { row ->
            row.indices.forEach { k ->
                row[k]?.let { row[k] = (it + deltaMs).coerceAtLeast(0L) }
            }
        }
    }

    /**
     * 校对页：只挪这一句的行首（句内字不动）。
     * 用于「句子起点正好，但句内逐字需要单独修」的场合。
     */
    fun nudgeLineBeginOnly(index: Int, deltaMs: Long) {
        val cur = begins.getOrNull(index) ?: return
        begins[index] = (cur + deltaMs).coerceAtLeast(0L)
    }

    /** 校对页：微调某一个字的开始时间（负=提前）。 */
    fun nudgeWord(lineIndex: Int, wordIndex: Int, deltaMs: Long) {
        val row = wordsDone.getOrNull(lineIndex) ?: return
        if (wordIndex !in row.indices) return
        val cur = row[wordIndex] ?: begins.getOrNull(lineIndex) ?: 0L
        row[wordIndex] = (cur + deltaMs).coerceAtLeast(0L)
    }

    /**
     * 校对页：删掉某一个字。
     * 原文里抠掉这段字符，同时把它的时间从逐字表里删掉——
     * 两边必须同步，否则字和时间再次错位一格，后面的字全会偏。
     */
    fun deleteWord(lineIndex: Int, wordIndex: Int) {
        val d = draft.getOrNull(lineIndex) ?: return
        val tokens = AxisTokenizer.splitWithRange(d.text)
        val tok = tokens.getOrNull(wordIndex) ?: return
        d.text = d.text.removeRange(tok.start, tok.end)
        wordsDone.getOrNull(lineIndex)?.let { row ->
            if (wordIndex in row.indices) row.removeAt(wordIndex)
        }
    }

    fun moveLine(index: Int, delta: Int) {
        val to = index + delta
        if (index !in draft.indices || to !in draft.indices) return
        val line = draft[index]
        draft[index] = draft[to]
        draft[to] = line
        if (index in begins.indices && to in begins.indices) {
            val t = begins[index]
            begins[index] = begins[to]
            begins[to] = t
        }
        if (index in wordsDone.indices && to in wordsDone.indices) {
            val w = wordsDone[index]
            wordsDone[index] = wordsDone[to]
            wordsDone[to] = w
        }
    }

    /**
     * 按行首时间重排整份歌词。
     *
     * 导入的 LRC 时间码经常是乱的，甚至有倒着写的（第 5 句比第 4 句还早），
     * 一句句手动挪太费劲。这里按时间从小到大排，没有时间的行统一排到最后，
     * 交给敲打时按顺序赋时间。
     */
    fun sortByTime() {
        if (draft.size < 2) return
        val order = draft.indices.sortedWith(
            compareBy(
                { begins.getOrNull(it) == null },
                { begins.getOrNull(it) ?: Long.MAX_VALUE },
                { it }
            )
        )
        val newDraft = order.map { draft[it] }
        val newBegins = order.map { begins.getOrNull(it) }
        val newWords = order.map { wordsDone.getOrNull(it) }
        draft.clear()
        newDraft.forEach { draft.add(it) }
        begins.clear()
        newBegins.forEach { begins.add(it) }
        wordsDone.clear()
        newWords.forEach { wordsDone.add(it ?: MutableList(0) { null }) }
        cursorLine = nextTappable(0)
        cursorChar = 0
    }

    /**
     * 舍弃超出歌长的行（只在带时间的歌词上判断）。
     * 导入的 lrc 自带时间，比歌还长的那些句子永远播不到，直接取消勾选。
     * 纯文本导入没有时间，判断不了，那条走 buildAxis 的 lastTapped 截断。
     */
    fun dropLinesOutOfRange() {
        if (durationMs <= 0L) {
            dropNotice = ""
            return
        }
        var dropped = 0
        draft.forEachIndexed { i, line ->
            val b = begins.getOrNull(i)
            if (b != null && b >= durationMs && line.keep) {
                line.keep = false
                dropped++
            }
        }
        dropNotice = if (dropped > 0) {
            "已自动舍弃 $dropped 句（超出这首歌 ${mmss(durationMs)}）"
        } else {
            ""
        }
    }

    /** 核对页改歌名 / 歌手：改了就以你为准，保存时不再被播放器覆盖（时长仍然听播放器的）。 */
    fun updateIdentity(newTitle: String? = null, newArtist: String? = null) {
        if (newTitle != null) title = newTitle
        if (newArtist != null) artist = newArtist
        identityEdited = true
    }

    fun buildAxis(): ManualAxis? {
        /*
         * 只保留"敲到最后一句"之前的行。
         * 手动从头敲的时候，敲到第 20 句歌就结束了，第 21 句往后本来就不存在，
         * 把她们一起存进去会得到一堆时间全挤在末尾的假行。lastTapped 就是这条刀口。
         * 一句都没敲时（={}）走 draft.size-1，交给 saveTo 的「一句都没敲」拦截去挡，不在这里产出废轴。
         */
        val lastTapped = draft.indices.lastOrNull { begins.getOrNull(it) != null } ?: -1
        // 编辑已有轴时不做这个截断：只改前几句就保存，后面的行必须原样留着，
        // 否则保存出来的轴只剩前几句，岛上播到后面就没歌词了。
        val cut = when {
            keepAllRows -> draft.size - 1
            lastTapped >= 0 -> lastTapped
            else -> draft.size - 1
        }
        val keptIdx = draft.indices.filter { draft[it].keep && it <= cut }
        if (keptIdx.isEmpty()) return null

        // 第一层：补行（沿用现有 fillMissing，一个字不改）
        val filledLines = AxisValidator.fillMissing(begins.toList(), durationMs)
        val texts = keptIdx.map { draft[it].text }
        val starts = keptIdx.map { filledLines[it] }

        // 第二层：补字
        val wordsForKept = keptIdx.map { i -> wordsDone.getOrNull(i)?.toList() }

        val lines = AxisValidator.toAxisLines(texts, starts, durationMs, wordsForKept)

        return ManualAxis(
            schema = 2,
            songKey = SongKey.of(title, artist, durationMs),
            title = title,
            artist = artist,
            durationMs = durationMs,
            leadMs = leadMs,
            offsetMs = offsetMs,
            precision = if (wordsForKept.any { it?.any { v -> v != null } == true }) Precision.CHAR else Precision.LINE,
            createdAt = System.currentTimeMillis(),
            lines = lines,
        )
    }

    fun saveTo(context: Context): Boolean {
        /*
         * 一句都没敲就保存，等于把岛上正在用的轴换成一条时间全是 0 的废轴：
         * fillMissing 对全空的行只会返回 0，fillWords 再按每字 80ms 均分，
         * 结果 44 句全挤在第 0 秒，画面上看起来就是"歌词没了"。
         * 更糟的是它会直接覆盖掉之前已经敲好的同一首歌的轴。
         */
        if (begins.count { it != null } == 0) {
            Toast.makeText(context, "一句都还没敲，先敲一句再保存", Toast.LENGTH_SHORT).show()
            return false
        }
        // 存之前再对齐一次。
        // 新建（从搜词 / 粘贴 / 本地文件来）：无条件认正在播的那首，保证岛上一定查得到。
        // 重打旧轴（editingKey 非空）：**名字不动**，只把时长对齐到播放器 ——
        // 否则用户点开 DJ 版重打、而正在放舒缓版，改完会存成舒缓版一条新的，DJ 版那份一个字没变，
        // 他会以为"点了保存没反应"。
        if (editingKey.isBlank()) {
            forceAlignToPlayer()
        } else {
            applyPlayerDuration()
        }
        val axis = buildAxis()
        if (axis == null) {
            Toast.makeText(context, "没有可保存的行，检查一下歌词勾选", Toast.LENGTH_SHORT).show()
            return false
        }
        val store = AxisStore(File(context.filesDir, "lyrics/manual"))
        store.save(axis, editingKey.takeIf { it.isNotBlank() })
        editingKey = ""
        keepAllRows = false
        // 通知 SystemUI 重新读盘：正在播的这首不用切歌也能立刻换成新轴
        // 顺便把这条轴的数据推过去，SystemUI 存在自己目录里，以后播放不必再叫醒 App
        ManualAxisApi.notifySaved(context, axis)
        savedAxis = axis
        recentStamp += 1
        route = Route.Save
        return true
    }

    fun exportLrc(context: Context): String? {
        val axis = savedAxis ?: return null
        val dir = context.getExternalFilesDir(null) ?: context.filesDir
        val file = File(dir, "axis-${abs(axis.songKey.hashCode())}.lrc")
        file.writeText(LrcWriter.format(axis))
        return file.absolutePath
    }

    // —— 轴文件分享：导出单首 / 导出整库 / 导入（SAF，不需要服务器）——

    /**
     * 首页「导入导出」里按 songKey 取一首已存的轴，导出通用 LRC（任何播放器都能直接用）。
     * 和 SaveScreen 的 exportLrc 区别：那边只导"当前这一首"，这边能导库里任意一首。
     */
    fun exportLrcOf(context: Context, axis: ManualAxis, uri: Uri): Boolean = runCatching {
        context.contentResolver.openOutputStream(uri)?.use { os ->
            os.write(LrcWriter.format(axis).toByteArray(Charsets.UTF_8))
        } != null
    }.getOrDefault(false)

    /** 同一首的逐字版（Enhanced LRC），只对认 `<mm:ss.xx>` 的播放器有效。 */
    fun exportWordsOf(context: Context, axis: ManualAxis, uri: Uri): Boolean = runCatching {
        context.contentResolver.openOutputStream(uri)?.use { os ->
            os.write(LrcWriter.formatEnhanced(axis).toByteArray(Charsets.UTF_8))
        } != null
    }.getOrDefault(false)

    /** 同上，但导出 .axis.json（原生格式，别人导进来能直接用）。 */
    fun exportAxisOf(context: Context, axis: ManualAxis, uri: Uri): Boolean =
        AxisExporter.exportOne(context, uri, axis)

    fun exportTo(context: Context, uri: Uri): Boolean {
        val axis = savedAxis ?: buildAxis() ?: return false
        return AxisExporter.exportOne(context, uri, axis)
    }

    fun exportAllTo(context: Context, uri: Uri): Boolean =
        AxisExporter.exportAll(context, uri)

    fun importFrom(context: Context, uri: Uri): ImportReport {
        val name = context.contentResolver.getType(uri).orEmpty()
        val report = if (name.contains("zip")) {
            AxisExporter.importAll(context, uri)
        } else {
            AxisExporter.importOne(context, uri)
        }
        if (report.ok > 0) recentStamp += 1
        return report
    }
}

internal fun mmss(ms: Long): String {
    val total = (ms / 1000).coerceAtLeast(0L)
    return java.lang.String.format("%02d:%02d", total / 60, total % 60)
}

internal fun mmssCentis(ms: Long): String {
    val total = ms.coerceAtLeast(0L)
    val sec = total / 1000
    val centis = (total % 1000) / 10
    return java.lang.String.format("%02d:%02d.%02d", sec / 60, sec % 60, centis)
}

@Composable
fun AxisApp(
    onClose: () -> Unit = {},
    initialTitle: String = "",
    initialArtist: String = "",
    initialDurationMs: Long = 0L,
    liveState: (() -> LiveState?)? = null,
    onControl: ((String, Long) -> Unit)? = null,
) {
    // 词岛侧带过来正在播放的歌时，直接进搜词页并自动开搜，省得用户再敲一遍名字
    val prefilled = initialTitle.isNotBlank()
    val state = remember {
        AxisState(
            initialTitle = initialTitle,
            initialArtist = initialArtist,
            initialDurationMs = initialDurationMs.takeIf { it > 0L } ?: 0L,
            startAtSearch = prefilled,
        )
    }
    LaunchedEffect(liveState, onControl) {
        state.bindLiveState(liveState, onControl)
        if (prefilled) state.startFollowing()
    }
    BackHandler(enabled = state.route != Route.Home) { state.back() }
    when (state.route) {
        Route.Home -> HomeScreen(state, onClose)
        Route.Search -> SearchScreen(state)
        Route.Paste -> PasteScreen(state)
        Route.Review -> ReviewScreen(state)
        Route.Tap -> TapScreen(state)
        Route.Proofread -> ProofreadScreen(state)
        Route.Save -> SaveScreen(state)
        Route.Transfer -> TransferScreen(state)
    }
}

@Composable
private fun HomeScreen(state: AxisState, onClose: () -> Unit) {
    val context = LocalContext.current
    val recent = remember(state.recentStamp) {
        runCatching { AxisStore(File(context.filesDir, "lyrics/manual")).list().take(3) }
            .getOrDefault(emptyList())
    }
    // .lrc / .txt 都按纯文本读，选文件后直接进核对页
    val askLocalFile = rememberLauncherForActivityResult(
        ActivityResultContracts.OpenDocument()
    ) { uri ->
        if (uri != null && !state.importLocalFile(context, uri)) {
            Toast.makeText(context, "这个文件读不出歌词", Toast.LENGTH_SHORT).show()
        }
    }
    AxisScreen(
        title = "打轴器",
        subtitle = "边听边敲，敲完存本地，岛会优先用它",
        onBack = onClose
    ) {
        Column(
            Modifier
                .fillMaxSize()
                .verticalScroll(rememberScrollState())
                .padding(horizontal = 16.dp)
        ) {
            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                EntryCard("网上搜词", "没歌词先搜一份", Modifier.weight(1f)) {
                    state.route = Route.Search
                }
                EntryCard("本地文件", ".lrc / .txt", Modifier.weight(1f)) {
                    askLocalFile.launch(arrayOf("*/*"))
                }
            }
            Spacer(Modifier.height(12.dp))
            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                EntryCard("粘贴文本", "手动粘进来", Modifier.weight(1f)) {
                    state.route = Route.Paste
                }
                EntryCard("当前播放取词", "从播放器读词", Modifier.weight(1f)) {
                    if (state.title.isBlank()) {
                        Toast.makeText(context, "没在播放，先手动填歌名搜", Toast.LENGTH_SHORT).show()
                        state.keyword = ""
                        state.route = Route.Search
                    } else {
                        // 已经是正在播的这首，直接搜
                        state.keyword = state.title
                        state.results.clear()
                        state.route = Route.Search
                    }
                }
            }
            Spacer(Modifier.height(12.dp))
