            if (state.searchError.isNotBlank()) {
                Spacer(Modifier.height(10.dp))
                Text(state.searchError, fontSize = 12.sp, color = AxisColors.Danger)
            }

            SectionLabel("搜索结果")
            state.results.forEach { candidate ->
                CandidateRow(
                    candidate = candidate,
                    targetMs = state.durationMs,
                    picking = state.pickingId.isNotEmpty() && state.pickingId == candidate.web?.id,
                    nowPlaying = state.isNowPlaying(candidate),
                ) {
                    if (state.pickingId.isEmpty()) scope.launch { state.pickCandidate(candidate) }
                }
                Spacer(Modifier.height(10.dp))
            }

            // 可选升级：不拖慢搜索主流程，需要逐字时再点
            if (state.title.isNotBlank()) {
                Spacer(Modifier.height(6.dp))
                GhostButton(if (state.upgrading) "正在查…" else "查逐字轴（在线逐字）", Modifier.fillMaxWidth()) {
                    if (!state.upgrading) scope.launch { state.upgradeToWordSync() }
                }
                if (state.upgradeMsg.isNotBlank()) {
                    Spacer(Modifier.height(6.dp))
                    Text(state.upgradeMsg, fontSize = 12.sp, color = AxisColors.TextSecondary)
                }
            }

            // 断网 / 搜不到时的兜底：粘进来直接敲
            SectionLabel("没网？把歌词粘进来")
            AxisCard {
                OutlinedTextField(
                    value = state.pasted,
                    onValueChange = { state.pasted = it },
                    placeholder = { Text("一行一句，直接粘就行") },
                    minLines = 4,
                    modifier = Modifier.fillMaxWidth()
                )
                Spacer(Modifier.height(10.dp))
                PrimaryButton("用这份歌词开始") {
                    if (!state.usePasted()) {
                        Toast.makeText(context, "先把歌词粘进来", Toast.LENGTH_SHORT).show()
                    }
                }
            }
            Spacer(Modifier.height(24.dp))
        }
    }
}

