/**
 * 首页「导入导出」。
 *
 * 单开一页而不是塞在"保存之后"的页面里，因为多数时候人只想把别人的轴导进来，
 * 压根不想先敲一遍。这一页不管你有没有在打轴都能进。
 *
 * 四件事：
 *   1. 导入轴文件（.json / .zip）—— 别人敲好的轴，进来就能直接用；
 *   2. 导入歌词（.lrc / .txt）—— 只有词，还得自己敲，直接进核对页；
 *   3. 导出整库 zip —— 备份 / 换机；
 *   4. 单首导出 .axis.json 或 .lrc —— 按库里现有的每一首，各导各的。
 */
@Composable
private fun TransferScreen(state: AxisState) {
    val context = LocalContext.current
    var hint by remember { mutableStateOf("") }
    var pending by remember { mutableStateOf<ManualAxis?>(null) }
    val store = remember { AxisStore(File(context.filesDir, "lyrics/manual")) }
    val all = remember(state.recentStamp) {
        runCatching { store.list() }.getOrDefault(emptyList())
    }

    val askImport = rememberLauncherForActivityResult(
        ActivityResultContracts.OpenDocument()
    ) { uri ->
        if (uri != null) {
            val name = displayName(context, uri).lowercase()
            val mime = context.contentResolver.getType(uri).orEmpty().lowercase()
            hint = when {
                // 轴文件：原生 json，或整库 zip
                name.endsWith(".axis.json") || name.endsWith(".json") || mime.contains("json") ->
                    state.importFrom(context, uri).label()
                name.endsWith(".zip") || mime.contains("zip") ->
                    state.importFrom(context, uri).label()
                // 其余当歌词读：.lrc / .txt
                else ->
                    if (state.importLocalFile(context, uri)) "已读入歌词，进核对页" else "这个文件读不出歌词"
            }
        }
    }

    val askExportAll = rememberLauncherForActivityResult(
        ActivityResultContracts.CreateDocument("application/zip")
    ) { uri ->
        if (uri != null) {
            hint = if (state.exportAllTo(context, uri)) "已导出整库" else "整库导出失败（可能还没有任何轴）"
        }
    }

    val askExportAxis = rememberLauncherForActivityResult(
        ActivityResultContracts.CreateDocument("application/json")
    ) { uri ->
        val axis = pending
        if (uri != null && axis != null) {
            hint = if (state.exportAxisOf(context, axis, uri)) "已导出 ${axis.title}.axis.json" else "导出失败"
        }
    }

    val askExportLrc = rememberLauncherForActivityResult(
        ActivityResultContracts.CreateDocument("text/plain")
    ) { uri ->
        val axis = pending
        if (uri != null && axis != null) {
            hint = if (state.exportLrcOf(context, axis, uri)) "已导出 ${axis.title}.lrc" else "导出失败"
        }
    }

    val askExportWords = rememberLauncherForActivityResult(
        ActivityResultContracts.CreateDocument("text/plain")
    ) { uri ->
        val axis = pending
        if (uri != null && axis != null) {
            hint = if (state.exportWordsOf(context, axis, uri)) {
                "已导出 ${axis.title}.words.lrc（逐字，仅部分播放器认）"
            } else {
                "导出失败"
            }
        }
    }

    AxisScreen(
        title = "导入导出",
        subtitle = "把别人的轴拿进来，或者把自己的轴给出去",
        onBack = { state.route = Route.Home }
    ) {
        Column(
            Modifier
                .fillMaxSize()
                .verticalScroll(rememberScrollState())
                .padding(horizontal = 16.dp)
        ) {
            SectionLabel("拿进来")
            AxisCard {
                Text(
                    "轴文件（.axis.json / .zip）：别人敲好的轴，导进来直接能用。",
                    fontSize = 12.sp,
                    color = AxisColors.TextSecondary
                )
                Spacer(Modifier.height(4.dp))
                Text(
                    "歌词文件（.lrc / .txt）：只有词，导进来还得自己敲，会先进核对页。",
                    fontSize = 12.sp,
                    color = AxisColors.TextSecondary
                )
                Spacer(Modifier.height(12.dp))
                GhostButton("选择文件导入", Modifier.fillMaxWidth()) {
                    askImport.launch(arrayOf("*/*"))
                }
            }

            SectionLabel("给出去")
            AxisCard {
                GhostButton("导出整库（zip）", Modifier.fillMaxWidth()) {
                    askExportAll.launch("axis-backup-${System.currentTimeMillis()}.zip")
                }
            }

            SectionLabel("单首导出（${all.size} 首）")
            AxisCard {
                if (all.isEmpty()) {
                    Text("还没有保存过的轴", fontSize = 14.sp, color = AxisColors.TextSecondary)
                } else {
                    all.forEachIndexed { index, entry ->
                        if (index > 0) {
                            Spacer(Modifier.height(10.dp))
                            Box(
                                Modifier
                                    .fillMaxWidth()
                                    .height(1.dp)
                                    .background(AxisColors.Line)
                            )
                            Spacer(Modifier.height(10.dp))
                        }
                        Column {
                            InfoRow(entry.title + " · " + entry.artist, entry.lineCount.toString() + " 句")
                            Spacer(Modifier.height(8.dp))
                            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                                GhostButton("导出 .axis.json", Modifier.weight(1f)) {
                                    val axis = store.load(entry.songKey)
                                    if (axis == null) {
                                        hint = "这首的轴文件读不出来，可能已经被删了"
                                    } else {
                                        pending = axis
                                        askExportAxis.launch("${axis.title}-${axis.artist}.axis.json")
                                    }
                                }
                                GhostButton("导出 .lrc", Modifier.weight(1f)) {
                                    val axis = store.load(entry.songKey)
                                    if (axis == null) {
                                        hint = "这首的轴文件读不出来，可能已经被删了"
                                    } else {
                                        pending = axis
                                        askExportLrc.launch("${axis.title}-${axis.artist}.lrc")
                                    }
                                }
                                GhostButton("逐字 LRC", Modifier.weight(1f)) {
                                    val axis = store.load(entry.songKey)
                                    if (axis == null) {
                                        hint = "这首的轴文件读不出来，可能已经被删了"
                                    } else {
                                        pending = axis
                                        askExportWords.launch("${axis.title}-${axis.artist}.words.lrc")
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if (hint.isNotBlank()) {
                Spacer(Modifier.height(10.dp))
                Text(
                    text = hint,
                    fontSize = 12.sp,
                    color = AxisColors.TextSecondary,
                    modifier = Modifier.align(Alignment.CenterHorizontally)
                )
            }
            Spacer(Modifier.height(10.dp))
            Text(
                ".lrc 是通用格式，任何播放器都能直接放；逐字 LRC 只给认尖括号时间的播放器用，别的播放器可能把角标当正文显示。",
                fontSize = 11.sp,
                color = AxisColors.TextSecondary
            )
            Spacer(Modifier.height(24.dp))
        }
    }
}

/** 取 SAF 里文件的原名，用来判断这份是轴文件还是歌词文件。 */
private fun displayName(context: Context, uri: Uri): String {
    return runCatching {
        context.contentResolver.query(
            uri,
            arrayOf(android.provider.OpenableColumns.DISPLAY_NAME),
            null,
            null,
            null
        )?.use { c -> if (c.moveToFirst()) c.getString(0) else null }
    }.getOrNull() ?: uri.lastPathSegment.orEmpty()
}

@Composable
private fun SearchScreen(state: AxisState) {
    val scope = rememberCoroutineScope()
    val context = LocalContext.current
    // 从首页/当前播放进来时自动搜一次；搜过就不重复搜
    LaunchedEffect(Unit) {
        if (state.results.isEmpty() && !state.searching && (state.title.isNotBlank() || state.keyword.isNotBlank())) {
            state.search()
        }
    }
    AxisScreen(
        title = "网上搜词",
        subtitle = "网易云为主、QQ 音乐兜底，改完再搜更准",
