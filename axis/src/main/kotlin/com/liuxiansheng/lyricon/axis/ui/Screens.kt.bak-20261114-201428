                .padding(horizontal = 16.dp)
        ) {
            AxisCard {
                Field("歌名", state.title) { state.title = it }
                Spacer(Modifier.height(10.dp))
                Field("歌手", state.artist) { state.artist = it }
                Spacer(Modifier.height(10.dp))
                Field("补充词", state.keyword) { state.keyword = it }
                Spacer(Modifier.height(14.dp))
                PrimaryButton(if (state.searching) "正在搜…" else "搜索") {
                    if (!state.searching) scope.launch { state.search() }
                }
