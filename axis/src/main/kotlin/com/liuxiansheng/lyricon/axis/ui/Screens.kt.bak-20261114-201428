@Composable
private fun TapScreen(state: AxisState) {
    val context = LocalContext.current
    // 想跟随但没跟上（会话还没绑上 / 刚切歌）时每 500ms 再试一次，别一失败就永远卡在独立计时
    LaunchedEffect(Unit) {
        while (true) {
            if (state.followIntent && !state.following) state.startFollowing()
            delay(500)
        }
    }
    // 跟随时即使播放器暂停也要继续轮询，否则暂停后再播就接不回来
    LaunchedEffect(state.following, state.playing) {
        var lastSync = 0L
        while (state.playing || state.following) {
            val now = SystemClock.elapsedRealtime()
            state.tick = now
            if (state.following && now - lastSync >= 500L) {
                state.syncFromPlayer()
                lastSync = now
            }
            delay(100)
        }
    }
    // 读一下 tick：它每 100ms 变一次，这页才会跟着时间重组。
    // （之前只往 tick 里写、没人读，界面等于冻住，位置和进度条都不动）
    val tickMs = state.tick
    val pos = state.positionMs()

    AxisScreen(
        title = null,
        onBack = { state.route = Route.Review },
        bottom = {
            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    GhostButton(if (state.playing) "暂停" else "播放", Modifier.width(58.dp)) {
                        state.playPause()
                    }
                    GhostButton("-5s", Modifier.width(52.dp)) { state.jump(-5000L) }
                    GhostButton("+5s", Modifier.width(52.dp)) { state.jump(5000L) }
                    GhostButton("开头", Modifier.width(52.dp)) { state.jumpTo(0L) }
                    GhostButton("撤销", Modifier.width(52.dp)) { state.undo() }
                }
                // 打开旧轴继续改时给一条退路：真要从头再敲，点这里把时间清空
                if (state.keepAllRows) {
                    GhostButton("清空时间，从头重敲", Modifier.fillMaxWidth()) {
                        state.clearTimesForRewrite()
                    }
                }
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Text(
                        text = if (state.following) "跟随中" else "点此跟随",
                        fontSize = 11.sp,
                        color = if (state.following) AxisColors.Primary else AxisColors.TextSecondary,
                        modifier = Modifier.width(66.dp).clickable { state.startFollowing() }
                    )
                    PressButton(
                        if (state.tapMode == TapMode.LINE) "敲行首" else "敲这个字",
                        Modifier.weight(1f)
                    ) { state.tap() }
                }
                // 出口：敲完能直接存，也能先校对
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    GhostButton("先校对", Modifier.weight(1f)) {
                        state.route = Route.Proofread
                    }
                    PrimaryButton("完成保存", Modifier.weight(1f)) {
                        state.saveTo(context)   // 失败时 saveTo 自己弹提示
                    }
                }
            }
        }
    ) {
        Column(Modifier.fillMaxSize().padding(horizontal = 16.dp)) {
            Spacer(Modifier.height(12.dp))
            AxisCard {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Box(
                        Modifier
                            .width(46.dp)
                            .height(46.dp)
                            .clip(RoundedCornerShape(10.dp))
                            .background(AxisColors.PrimarySoft)
                    )
                    Spacer(Modifier.width(12.dp))
                    Column(Modifier.weight(1f)) {
                        Text(
                            text = state.title,
                            fontSize = 15.sp,
                            fontWeight = FontWeight.Medium,
                            color = AxisColors.TextPrimary
                        )
                        Text(state.artist, fontSize = 11.sp, color = AxisColors.TextSecondary)
                    }
                    Text(mmssCentis(pos), fontSize = 12.sp, color = AxisColors.TextSecondary)
                }
                Spacer(Modifier.height(12.dp))
                // 进度条可拖：拖的时候跟手，松手就把歌真正跳到那个位置
                var dragging by remember { mutableStateOf(false) }
                var dragMs by remember { mutableStateOf(0f) }
                Slider(
                    value = if (dragging) dragMs else pos.toFloat(),
                    onValueChange = { dragging = true; dragMs = it },
                    onValueChangeFinished = {
                        state.jumpTo(dragMs.toLong())
                        dragging = false
                    },
                    valueRange = 0f..(state.durationMs.toFloat().coerceAtLeast(1f)),
                    modifier = Modifier.fillMaxWidth()
                )
                Spacer(Modifier.height(8.dp))
                Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(10.dp)) {
                    Text("调值", fontSize = 11.sp, color = AxisColors.TextSecondary)
                    GhostButton("−50", Modifier.height(28.dp)) {
                        state.offsetMs = (state.offsetMs - 50).coerceIn(-1000, 1000)
                    }
                    Text(
                        text = if (state.offsetMs == 0) "0ms" else "${state.offsetMs}ms",
                        fontSize = 11.sp,
                        color = AxisColors.TextSecondary
                    )
                    GhostButton("+50", Modifier.height(28.dp)) {
                        state.offsetMs = (state.offsetMs + 50).coerceIn(-1000, 1000)
                    }
                    Text(
                        text = "第 ${(state.cursorLine + 1).coerceAtMost(state.draft.size)} 句 · " +
                            "${state.wordsDone.getOrNull(state.cursorLine)?.count { it != null } ?: 0}/" +
                            "${state.wordsDone.getOrNull(state.cursorLine)?.size ?: 0} 字",
                        fontSize = 11.sp,
                        color = AxisColors.TextSecondary
                    )
                    Spacer(Modifier.weight(1f))
                    GhostButton(
                        if (state.tapMode == TapMode.CHAR) "逐字敲" else "快敲",
                        Modifier.height(28.dp)
                    ) {
                        state.tapMode = if (state.tapMode == TapMode.CHAR) TapMode.LINE else TapMode.CHAR
                    }
                }
            }

            Spacer(Modifier.height(10.dp))

            // 只列勾选了要敲的行；未勾选的行不删数据，回核对页还能改
            val keptIdx = state.draft.indices.filter { state.draft[it].keep }
            val listState = rememberLazyListState()
            // 敲到哪就跟着滚到哪，别让当前行掉到底部按钮后面看不见
            LaunchedEffect(state.cursorLine, keptIdx.size) {
                val pos = keptIdx.indexOf(state.cursorLine)
                if (pos >= 0) listState.animateScrollToItem((pos - 1).coerceAtLeast(0))
            }

            LazyColumn(
                state = listState,
                modifier = Modifier.weight(1f),
                // 底部留出按钮区的高度，滚到最后一行也能完整露出来
                contentPadding = PaddingValues(bottom = 96.dp),
                verticalArrangement = Arrangement.spacedBy(2.dp)
            ) {
                if (keptIdx.isEmpty()) {
                    item {
                        Text(
                            "没有勾选歌词，返回核对页勾选需要的句子",
                            fontSize = 12.sp,
                            color = AxisColors.TextSecondary,
                            modifier = Modifier.padding(vertical = 24.dp)
                        )
                    }
                }
                items(keptIdx.size) { pos ->
                    val index = keptIdx[pos]
                    val line = state.draft[index]
                    val begin = state.begins[index]
                    val isCursor = index == state.cursorLine
                    Row(
                        Modifier
                            .fillMaxWidth()
                            .clip(RoundedCornerShape(10.dp))
                            .background(if (isCursor) AxisColors.PrimarySoft else Color.Transparent)
                            .padding(horizontal = 8.dp, vertical = 11.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        if (isCursor) {
                            Box(Modifier.width(3.dp).height(18.dp).background(AxisColors.Primary))
                        }
                        Spacer(Modifier.width(8.dp))
                        val words = remember(index, line.text) { AxisTokenizer.split(line.text) }
                        val done = state.wordsDone.getOrNull(index)
                        val charCursor = isCursor && state.tapMode == TapMode.CHAR
                        Text(
                            text = buildAnnotatedString {
                                words.forEachIndexed { wi, w ->
                                    val style = when {
                                        charCursor && wi == state.cursorChar ->
                                            SpanStyle(color = Color.White, background = AxisColors.Primary)
                                        done?.getOrNull(wi) != null -> SpanStyle(color = AxisColors.Primary)
                                        else -> SpanStyle(color = AxisColors.TextSecondary)
                                    }
                                    withStyle(style) { append(w) }
                                }
                            },
                            fontSize = 15.sp,
                            modifier = Modifier.weight(1f)
                        )
                        if (isCursor) {
                            Tag("待敲")
                        } else if (begin != null) {
                            Text(mmssCentis(begin), fontSize = 11.sp, color = AxisColors.TextSecondary)
                        }
                    }
                }
            }
        }
    }
}

@Composable
private fun ProofreadScreen(state: AxisState) {
    val context = LocalContext.current
    val keptIdx = state.draft.indices.filter { state.draft[it].keep }
    val filled = AxisValidator.fillMissing(state.begins.toList(), state.durationMs)
    val texts = keptIdx.map { state.draft[it].text }
    val starts = keptIdx.map { filled[it] }
    val axisLines = AxisValidator.toAxisLines(texts, starts, state.durationMs)
    val issues: List<AxisIssue> = AxisValidator.issues(axisLines, state.durationMs)
    val issueIndexes = issues.map { it.index }.toSet()
    // 点某一句就展开它的逐字表（再点收起）；记的是 draft 里的行号
    var openLine by remember { mutableStateOf(-1) }

    AxisScreen(
        title = "校对",
        subtitle = "共 ${axisLines.size} 句 · 异常 ${issues.size} 处",
        onBack = { state.route = Route.Tap },
        bottom = {
            Column {
                // 整首一起挪：行时间和逐字时间同时改，逐字不会因此错位
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    GhostButton("全曲 -1s", Modifier.weight(1f)) { state.shiftAll(-1000L) }
                    GhostButton("全曲 -0.1s", Modifier.weight(1f)) { state.shiftAll(-100L) }
                    GhostButton("全曲 +0.1s", Modifier.weight(1f)) { state.shiftAll(100L) }
                    GhostButton("全曲 +1s", Modifier.weight(1f)) { state.shiftAll(1000L) }
                }
                Spacer(Modifier.height(10.dp))
                PrimaryButton("完成并保存") {
                    state.saveTo(context)   // 失败时 saveTo 自己弹提示
                }
            }
        }
    ) {
        LazyColumn(
            Modifier.fillMaxSize().padding(horizontal = 16.dp),
            verticalArrangement = Arrangement.spacedBy(6.dp)
        ) {
            // 顺序整份乱了就别一句句挪：按时间码一次性排好
            if (keptIdx.size > 1) {
                item {
                    Row(
                        Modifier.fillMaxWidth().padding(vertical = 4.dp),
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Text(
            text = "顺序不对可↑↓逐行挪，或",
                            fontSize = 11.sp,
                            color = AxisColors.TextSecondary
                        )
                        GhostButton("按时间排序", Modifier.height(26.dp)) { state.sortByTime() }
                    }
                }
            }
            itemsIndexed(axisLines) { index, line ->
                val raw = keptIdx.getOrNull(index)
                val prev = if (index > 0) axisLines[index - 1].beginMs else null
                val delta = if (prev != null) line.beginMs - prev else null
                val bad = index in issueIndexes
                val open = raw != null && raw == openLine
                Column(
                    Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(12.dp))
                        .background(if (bad) AxisColors.DangerSoft else AxisColors.Card)
                ) {
                    Row(
                        Modifier
                            .fillMaxWidth()
                            .clickable { openLine = if (open) -1 else (raw ?: -1) }
                            .padding(horizontal = 12.dp, vertical = 10.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            text = "${index + 1}",
                            fontSize = 12.sp,
                            color = AxisColors.TextSecondary,
                            modifier = Modifier.width(22.dp)
                        )
                        Text(
                            text = line.text,
                            fontSize = 14.sp,
                            color = AxisColors.TextPrimary,
                            modifier = Modifier.weight(1f)
                        )
                        Column(horizontalAlignment = Alignment.End) {
                            Text(mmssCentis(line.beginMs), fontSize = 12.sp, color = AxisColors.TextPrimary)
                            if (delta != null) {
                                Text(
                                    text = "Δ ${delta / 1000.0}s",
                                    fontSize = 10.sp,
                                    color = if (bad) AxisColors.Danger else AxisColors.TextSecondary
                                )
                            }
                        }
                        if (raw != null) {
                            Column {
                                GhostButton("↑", Modifier.width(30.dp).height(24.dp)) {
                                    state.moveLine(raw, -1)
                                }
                                GhostButton("↓", Modifier.width(30.dp).height(24.dp)) {
                                    state.moveLine(raw, 1)
                                }
                            }
                        }
                    }
                    // 展开区：整句平移 + 逐字微调/删字
                    if (open && raw != null) {
                        Row(
                            Modifier.fillMaxWidth().padding(start = 12.dp, end = 12.dp, bottom = 6.dp),
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.spacedBy(6.dp)
                        ) {
                            Text("本句", fontSize = 10.sp, color = AxisColors.TextSecondary)
                            TinyButton("−100") { state.nudgeLine(raw, -100L) }
                            TinyButton("−50") { state.nudgeLine(raw, -50L) }
                            TinyButton("+50") { state.nudgeLine(raw, 50L) }
                            TinyButton("+100") { state.nudgeLine(raw, 100L) }
                        }
                        val words = AxisTokenizer.split(state.draft.getOrNull(raw)?.text ?: line.text)
                        val done = state.wordsDone.getOrNull(raw)
                        words.forEachIndexed { wi, w ->
                            Row(
                                Modifier
                                    .fillMaxWidth()
                                    .padding(horizontal = 12.dp, vertical = 3.dp),
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(6.dp)
                            ) {
                                Text(
                                    text = "${wi + 1}",
                                    fontSize = 10.sp,
                                    color = AxisColors.TextSecondary,
                                    modifier = Modifier.width(16.dp)
                                )
                                Text(
                                    text = w,
                                    fontSize = 13.sp,
                                    color = AxisColors.TextPrimary,
                                    modifier = Modifier.width(28.dp)
                                )
                                Text(
                                    text = done?.getOrNull(wi)?.let { mmssCentis(it) } ?: "—",
                                    fontSize = 11.sp,
                                    color = AxisColors.TextSecondary,
                                    modifier = Modifier.weight(1f)
                                )
                                TinyButton("−50") { state.nudgeWord(raw, wi, -50L) }
                                TinyButton("+50") { state.nudgeWord(raw, wi, 50L) }
                                TinyButton("删") { state.deleteWord(raw, wi) }
                            }
                        }
                        Spacer(Modifier.height(6.dp))
                    }
                }
            }
        }
    }
}

@Composable
private fun SaveScreen(state: AxisState) {
    val context = LocalContext.current
    val axis = state.savedAxis
    var importHint by remember { mutableStateOf("") }

    val askExportOne = rememberLauncherForActivityResult(
        ActivityResultContracts.CreateDocument("application/json")
    ) { uri ->
        if (uri != null) {
            val ok = state.exportTo(context, uri)
            importHint = if (ok) "已导出 ${state.title}-${state.artist}.axis.json" else "导出失败"
        }
    }
    val askExportAll = rememberLauncherForActivityResult(
        ActivityResultContracts.CreateDocument("application/zip")
    ) { uri ->
        if (uri != null) {
            val ok = state.exportAllTo(context, uri)
            importHint = if (ok) "已导出整库" else "整库导出失败（可能还没有任何轴）"
        }
    }
    val askImport = rememberLauncherForActivityResult(
        ActivityResultContracts.OpenDocument()
    ) { uri ->
        if (uri != null) importHint = state.importFrom(context, uri).label()
    }
    AxisScreen(title = null, onBack = { state.route = Route.Home }) {
        Column(
            Modifier
                .fillMaxSize()
                .verticalScroll(rememberScrollState())
                .padding(horizontal = 20.dp)
        ) {
            Spacer(Modifier.height(60.dp))
            Box(
                Modifier
                    .align(Alignment.CenterHorizontally)
                    .width(54.dp)
                    .height(54.dp)
                    .clip(RoundedCornerShape(27.dp))
                    .background(AxisColors.Success)
            )
            Spacer(Modifier.height(16.dp))
            Text(
                text = "轴已保存",
                fontSize = 22.sp,
                fontWeight = FontWeight.SemiBold,
                color = AxisColors.TextPrimary,
                modifier = Modifier.align(Alignment.CenterHorizontally)
            )
            Spacer(Modifier.height(6.dp))
            Text(
                text = if (axis != null) "${axis.title} · ${axis.artist} · ${axis.lines.size} 句" else "没有保存内容",
                fontSize = 12.sp,
                color = AxisColors.TextSecondary,
                modifier = Modifier.align(Alignment.CenterHorizontally)
            )
            Spacer(Modifier.height(8.dp))
            // 保存那一刻就已经通知状态栏重新读轴了，正常不用切歌
            Text(
                text = "已保存 · 点下面的按钮回桌面，抬眼就是岛上的新轴",
                fontSize = 11.sp,
                color = AxisColors.TextSecondary,
                modifier = Modifier.align(Alignment.CenterHorizontally)
            )
            Spacer(Modifier.height(24.dp))
            AxisCard {
                InfoRow("起始时间", axis?.lines?.firstOrNull()?.let { mmssCentis(it.beginMs) } ?: "-")
                Spacer(Modifier.height(8.dp))
                InfoRow("结束时间", axis?.lines?.lastOrNull()?.let { mmssCentis(it.endMs) } ?: "-")
                Spacer(Modifier.height(8.dp))
                InfoRow("命中歌曲", axis?.songKey ?: "-")
            }
            Spacer(Modifier.height(20.dp))
            GhostButton("导出这一首（.axis.json）", Modifier.fillMaxWidth()) {
                askExportOne.launch("${state.title}-${state.artist}.axis.json")
            }
            Spacer(Modifier.height(10.dp))
            GhostButton("导出全部（zip）", Modifier.fillMaxWidth()) {
                askExportAll.launch("axis-backup-${System.currentTimeMillis()}.zip")
            }
            Spacer(Modifier.height(10.dp))
            GhostButton("导入轴文件", Modifier.fillMaxWidth()) {
                askImport.launch(arrayOf("application/json", "application/zip", "application/octet-stream"))
            }
            Spacer(Modifier.height(4.dp))
            Text(
                text = importHint,
                fontSize = 11.sp,
                color = AxisColors.TextSecondary,
                modifier = Modifier.align(Alignment.CenterHorizontally)
            )
            Spacer(Modifier.height(10.dp))
            GhostButton("导出 LRC 文件", Modifier.fillMaxWidth()) {
                val path = state.exportLrc(context)
                Toast.makeText(context, path ?: "先保存再导出", Toast.LENGTH_LONG).show()
            }
            Spacer(Modifier.height(10.dp))
            PrimaryButton("回到岛上预览") {
                // 保存时已经通知状态栏重读轴了，这里只要退出到桌面，抬眼就能看到新轴。
                // 打轴器是嵌在主工程里的二级页，所以"预览"= 回桌面，不需要另开预览界面。
                val activity = context.findActivity()
                if (activity != null) {
                    activity.moveTaskToBack(true)
                } else {
                    runCatching {
                        context.startActivity(
                            Intent(Intent.ACTION_MAIN)
                                .addCategory(Intent.CATEGORY_HOME)
                                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                        )
                    }.onFailure {
                        Toast.makeText(context, "退不回桌面，按 Home 键即可", Toast.LENGTH_SHORT).show()
                    }
                }
            }
            Spacer(Modifier.height(14.dp))
            Text(
                text = "稍后再说",
                fontSize = 13.sp,
                color = AxisColors.TextSecondary,
                modifier = Modifier
                    .align(Alignment.CenterHorizontally)
                    .clickable { state.route = Route.Home }
            )
            Spacer(Modifier.height(40.dp))
        }
    }
}

@Composable
private fun InfoRow(label: String, value: String) {
    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
        Text(label, fontSize = 12.sp, color = AxisColors.TextSecondary, modifier = Modifier.weight(1f))
        Text(value, fontSize = 12.sp, color = AxisColors.TextPrimary)
    }
}

/**
 * Compose 里的 Context 常被包了几层（ContextThemeWrapper 之类），
 * 直接 as Activity 会失手，沿 ContextWrapper 往上找才稳。
 */
private fun Context.findActivity(): Activity? {
    var current: Context = this
    while (current is ContextWrapper) {
        if (current is Activity) return current
        current = current.baseContext
    }
    return null
}
