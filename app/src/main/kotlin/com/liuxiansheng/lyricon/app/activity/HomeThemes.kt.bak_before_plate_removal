/** 按底版原图坐标写一行文字：x/y/widthPx 都是 1152×2047 原图像素 */
@Composable
private fun BoxScope.PlateText(
    x: Float,
    y: Float,
    f: Float,
    text: String,
    size: Float,
    color: Color,
    weight: FontWeight = FontWeight.Normal,
    widthPx: Float = 0f,
    center: Boolean = false,
) {
    val base = Modifier
        .align(Alignment.TopStart)
        .offset(x = (x * f).dp, y = ((y - size * 0.16f) * f).dp)
    Text(
        text = text,
        fontSize = (size * f).sp,
        fontWeight = weight,
        color = color,
        maxLines = 1,
        overflow = TextOverflow.Clip,
        textAlign = if (center) {
            androidx.compose.ui.text.style.TextAlign.Center
        } else {
            androidx.compose.ui.text.style.TextAlign.Start
        },
        modifier = if (widthPx > 0f) base.width((widthPx * f).dp) else base,
    )
}

/** 品牌图标：与底版上的蓝色圆角块同尺寸，只补白色音频柱与三条横线 */
@Composable
private fun PlateLogo(f: Float) {
    Canvas(Modifier.size((116f * f).dp)) {
        val w = size.width
        val h = size.height
        drawRoundRect(
            brush = Brush.verticalGradient(
                listOf(Color(0xFF4D90FF), Color(0xFF2C6BF0)),
            ),
            cornerRadius = CornerRadius(w * 0.24f),
        )
        val white = Color.White
        // 五根音频柱
        val bars = listOf(0.30f, 0.46f, 0.62f, 0.46f, 0.30f)
        val bw = w * 0.052f
        bars.forEachIndexed { i, ratio ->
            val cx = w * (0.22f + i * 0.14f)
            val bh = h * ratio * 0.62f
            drawRoundRect(
                color = white,
                topLeft = Offset(cx - bw / 2, h * 0.20f + (h * 0.36f - bh) / 2),
                size = Size(bw * 1.35f, bh),
                cornerRadius = CornerRadius(bw * 0.6f),
            )
        }
        // 三条横线
        for (i in 0 until 3) {
            val yy = h * (0.60f + i * 0.10f)
            drawRoundRect(
                color = white,
                topLeft = Offset(w * 0.20f, yy),
                size = Size(w * 0.36f, h * 0.045f),
                cornerRadius = CornerRadius(h * 0.02f),
            )
        }
    }
}

@Composable
private fun BoardHome(
    skin: HomeSkin,
    skinId: Int,
    live: HomeLive,
    moduleActive: Boolean,
    context: Context,
    onOpenAxis: () -> Unit,
    onOpenSuperIsland: () -> Unit,
    onOpenStatusBarLyric: () -> Unit,
    onOpenLyricSource: () -> Unit,
    onOpenAdvanced: () -> Unit,
    onOpenRecords: () -> Unit,
) {
    val scope = rememberCoroutineScope()
    val now = live.now
    val todayStart = remember { dayStartMs() }
    val today = live.records.filter { it.time >= todayStart }
    val todayMs = today.sumOf { it.listenedMs }

    var islandOn by remember {
        mutableStateOf(
            MasterPrefs.getBoolean(context, MasterPrefs.KEY_ENABLE_SUPER_ISLAND, true)
        )
    }
    var showNoRoot by remember { mutableStateOf(false) }
    NoRootDialog(visible = showNoRoot, context = context, onDismiss = { showNoRoot = false })

    // 背景（按效果图采样值还原）：
    // 底色是"左上偏白 → 右侧偏蓝"的横向对角渐变（左 #F8F9FF、右 #DEEAFE），
    // 上面再压一层很淡的竖细条纹（周期约 20dp，明暗起伏约 5%），也就是效果图里
    // 那层丝一样的竖纹；底部再极轻地压暗一点。
    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                Brush.linearGradient(
                    colorStops = arrayOf(
                        0.00f to Color(0xFFF9FAFF),
                        0.32f to Color(0xFFF1F5FE),
                        0.66f to Color(0xFFE7EFFD),
                        1.00f to Color(0xFFDDE9FE),
                    )
                )
            )
    ) {
        Canvas(Modifier.fillMaxSize()) {
            val w = size.width
            val h = size.height

            // 底部轻压暗
            drawRect(
                brush = Brush.verticalGradient(
                    colorStops = arrayOf(
                        0.55f to Color(0x002C77F2),
                        1.00f to Color(0x102C77F2),
                    )
                )
            )

            // 丝状竖条纹：正弦起伏，白光提亮 + 蓝光压暗交错
            val period = 20.dp.toPx()
            val step = 1.6.dp.toPx()
            var x = 0f
            while (x < w) {
                val t = (x % period) / period
                val v = kotlin.math.sin(t * 2f * Math.PI.toFloat())
                if (v > 0.05f) {
                    drawLine(
                        color = Color(0xFFFFFFFF).copy(alpha = 0.055f * v),
                        start = Offset(x, 0f),
                        end = Offset(x, h),
                        strokeWidth = step,
                    )
                } else if (v < -0.05f) {
                    drawLine(
                        color = Color(0xFF2C77F2).copy(alpha = 0.085f * -v),
                        start = Offset(x, 0f),
                        end = Offset(x, h),
                        strokeWidth = step,
                    )
                }
                x += step
            }
        }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .windowInsetsPadding(WindowInsets.statusBars)
            .verticalScroll(rememberScrollState())
            .padding(horizontal = 18.dp),
    ) {
        // ---- 品牌行：白底 logo + 词岛 + 重启状态栏 ----
