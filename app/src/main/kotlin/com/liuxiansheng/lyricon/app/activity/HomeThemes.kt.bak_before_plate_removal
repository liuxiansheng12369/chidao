/** iOS 风格自绘开关：44×24dp 轨道（蓝色渐变）+ 18dp 白色滑块，比 Material Switch 更大更清楚。 */
@Composable
private fun BoardSwitch(
    checked: Boolean,
    onCheckedChange: (Boolean) -> Unit,
    modifier: Modifier = Modifier,
) {
    Canvas(
        modifier = modifier
            .size(width = 44.dp, height = 24.dp)
            .shadow(
                elevation = 6.dp,
                shape = RoundedCornerShape(12.dp),
                clip = false,
                ambientColor = Color(0x3D2C77F2),
                spotColor = Color(0x3D2C77F2),
            )
            .clickable { onCheckedChange(!checked) }
    ) {
        val h = size.height
        val r = h / 2f
        val trackColors = if (checked) {
            listOf(Color(0xFF5FA2FF), Color(0xFF2C77F2))
        } else {
            listOf(Color(0xFFDCE4F2), Color(0xFFC6D2E6))
        }
        drawRoundRect(
            brush = Brush.horizontalGradient(trackColors),
            size = Size(size.width, h),
            cornerRadius = CornerRadius(r, r),
        )
        // 轨道内高光：只在上半部铺一层白，做出"自己会亮"的感觉，而不是外圈糊光
        drawRoundRect(
            brush = Brush.verticalGradient(
                colors = listOf(Color(0x4DFFFFFF), Color(0x00FFFFFF)),
                startY = 0f,
                endY = h * 0.62f,
            ),
            topLeft = Offset(1.5f, 1.2f),
            size = Size(size.width - 3f, h * 0.58f),
            cornerRadius = CornerRadius(h * 0.29f),
        )
        val knobR = r - 2.dp.toPx()
        val cx = if (checked) size.width - r else r
        // 滑块投影 + 白色圆
        drawCircle(
            color = Color(0x22000000),
            radius = knobR,
            center = Offset(cx, h / 2f + 1.dp.toPx()),
        )
        drawCircle(
            color = Color.White,
            radius = knobR,
            center = Offset(cx, h / 2f),
        )
    }
}

